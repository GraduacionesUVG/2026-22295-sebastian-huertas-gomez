+name: Latency Benchmark
+
+# Manual trigger only, on purpose. This job runs the full latency suite
+# (attack-sim/run_latency_suite.sh: 3 scenarios x 2 conditions x 5 reps,
+# each rep a 15s warmup + 60s measured Artillery run) end to end, which
+# takes ~37-42 minutes for real - see the comment on the `benchmark` job
+# below for the exact math. That is not something that should fire on
+# every push/PR; it is meant to be run deliberately, on ubuntu-latest (real
+# Linux), to produce the numbers this project's Docker stack has never
+# actually been measured on before (every number in this project's docs up
+# to this workflow's introduction was measured on Docker Desktop/macOS,
+# never on native Linux).
+on:
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+
+jobs:
+  benchmark:
+    name: Latency, coverage-load and memory/CPU benchmark (native Linux)
+    runs-on: ubuntu-latest
+    # Expected real duration: ~40-45 minutes (3 scenarios x 2 conditions x
+    # 5 reps x 75s/rep = 2250s = 37.5min for the Artillery portion alone,
+    # plus ~6 app-container recreates, the docker build, and npm/artillery
+    # install). timeout-minutes below is a safety ceiling, not the expected
+    # duration - if this job is regularly finishing near 90 minutes,
+    # something is wrong (a hung `wait_for_app` retry loop, a stuck
+    # container recreate), not just "CI is slow today".
+    timeout-minutes: 90
+    env:
+      COMPOSE_FILES: -f docker-compose.yml -f docker-compose.direct.yml
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+
+      # Satisfies PLAN.md:157's hardware-documentation requirement, which no
+      # latency measurement in this project's history (Docker Desktop/macOS
+      # runs included) has ever actually recorded. Printed early, before any
+      # load runs, so it's attributable to the exact run that produced the
+      # numbers in this job's artifact, not asserted separately after the
+      # fact.
+      - name: Document runner hardware
+        run: |
+          echo "== uname -a =="
+          uname -a
+          echo "== nproc =="
+          nproc
+          echo "== free -h =="
+          free -h
+          echo "== node --version =="
+          node --version
+          echo "== docker --version =="
+          docker --version
+          echo "== docker compose version =="
+          docker compose version
+
+      - name: Install Artillery
+        # Pinned to the exact version this harness was validated against
+        # locally (Docker Desktop/macOS - see this repo's latency-harness
+        # validation notes) so a future Artillery release changing its JSON
+        # report shape doesn't silently break parse-latency-report.js here
+        # without anyone noticing. Bump deliberately, re-validate
+        # attack-sim/parse-latency-report.js against the new report shape
+        # when you do.
+        run: npm install -g artillery@2.0.34
+
+      - name: Build and start the app + db stack
+        run: docker compose ${{ env.COMPOSE_FILES }} up -d --build app db
+
+      - name: Wait for app to answer
+        run: |
+          for i in $(seq 1 60); do
+            if curl -sf -o /dev/null http://localhost:3000/login; then
+              echo "app is up"
+              exit 0
+            fi
+            sleep 1
+          done
+          echo "app never became ready" >&2
+          docker compose ${{ env.COMPOSE_FILES }} logs app
+          exit 1
+
+      # Started in the background BEFORE the latency suite and stopped
+      # right after it, so the memory/CPU sample window covers the suite's
+      # entire ~37-38 minute real runtime. That is how this workflow
+      # satisfies the protocol's ">=30min sustained load" memory-leak check
+      # without a separate dedicated stress phase: the latency suite's own
+      # mixed warmup+measured traffic across 3 scenarios x 2 conditions x 5
+      # reps already IS >=30 minutes of real, varied load against the same
+      # `app` container. If a future change shrinks REPS/durations below
+      # ~30 minutes total, this comment (and the decision it documents)
+      # stops being true and monitor-memory.sh's sampling window should be
+      # re-derived, not assumed.
+      #
+      # `nohup ... & disown` so the sampler survives this step's shell
+      # exiting (each `run:` block is its own bash process; without this
+      # the background child can receive SIGHUP when its parent step ends).
+      - name: Start memory/CPU monitor (background, samples for the whole suite run below)
+        run: |
+          mkdir -p attack-sim/results
+          nohup attack-sim/monitor-memory.sh attack-sim/results/memory-cpu.csv 5 ${{ env.COMPOSE_FILES }} \
+            > attack-sim/results/monitor-memory.log 2>&1 &
+          echo $! > monitor.pid
+          disown
+          echo "monitor-memory.sh started, pid $(cat monitor.pid)"
+
+      # The single real workload this workflow exists to produce: normal
+      # load, attack load, and realistic-data-volume load, each as
+      # baseline (LOGSGUARDIAN_DISABLED=true) vs active, 5 reps per
+      # condition with max/min dropped and the median of the remaining 3
+      # reported, per protocolo_sebastian's acceptance metric (Delta p95
+      # <=5% normal load / <=10% attack load - see
+      # attack-sim/run_latency_suite.sh's own header for the full design
+      # rationale, including why it recreates the `app` container itself
+      # rather than being handed a fixed one).
+      - name: Run latency suite (normal, attack, volume x baseline/active x 5 reps)
+        run: attack-sim/run_latency_suite.sh ${{ env.COMPOSE_FILES }}
+
+      - name: Stop memory/CPU monitor
+        if: always()
+        run: |
+          if [ -f monitor.pid ]; then
+            kill -TERM "$(cat monitor.pid)" 2>/dev/null || true
+            sleep 2
+          fi
+
+      - name: Analyze memory/CPU sample (leak check)
+        if: always()
+        run: |
+          if [ -f attack-sim/results/memory-cpu.csv ]; then
+            node attack-sim/analyze-memory.js attack-sim/results/memory-cpu.csv \
+              | tee attack-sim/results/memory-analysis.json
+          else
+            echo "no memory-cpu.csv produced - monitor-memory.sh likely failed to start, see monitor-memory.log" >&2
+          fi
+
+      - name: Dump app logs on failure
+        if: failure()
+        run: docker compose ${{ env.COMPOSE_FILES }} logs app db
+
+      - name: Upload results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: latency-benchmark-results
+          path: |
+            attack-sim/results/**
+          if-no-files-found: warn
+          retention-days: 30
